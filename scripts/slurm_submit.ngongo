#!/bin/bash
# shellcheck disable=SC2090,SC2086,SC2089,SC1091
#!SBATCH -c 1
#SBATCH -c 32
#SBATCH -w ngongotaha
#SBATCH --gres=gpu:4
#SBATCH --job-name=diloco_75M
#!SBATCH --job-name=test-hf-flower-llm
#!SBATCH --job-name=test-deepspeed
#!SBATCH --job-name=test
#!SBATCH --job-name=eval-gauntlet
#SBATCH --tasks-per-node=1
#SBATCH --output=%x-%j.out
#SBATCH --partition=normal
#!SBATCH --time=01:00:00
#SBATCH --dependency=afterany:13377

# Default project path
PROJECT_PATH="$HOME/projects/flower_llm"


# Parse command-line options
if ! OPTIONS=$(getopt -o p: --long project_path: -n 'parse-options' -- "$@"); then
  echo "slurm_submit.ngongo: Error parsing options" >&2
  exit 1
fi

eval set -- "$OPTIONS"

while true; do
  case "$1" in
    -p | --project_path )
      PROJECT_PATH="$2"; shift 2 ;;
    -- )
      shift; break ;;
    * )
      break ;;
  esac
done
# eval "$(cat /home/ls985/.bashrc | tail -n +10)"
echo "slurm_submit.ngongo: PROJECT_PATH=$PROJECT_PATH, LD_LIBRARY_PATH=$LD_LIBRARY_PATH, PATH=$PATH"

