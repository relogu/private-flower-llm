#!/bin/bash
# shellcheck disable=SC2090,SC2086,SC2089,SC1091
#SBATCH -c 20
#SBATCH -w gpu-vm
#!SBATCH --gres=gpu:1
#SBATCH --gres=gpu:2
#!SBATCH --job-name=fed_llm_75M
#!SBATCH --job-name=fed_llm_125M
#!SBATCH --job-name=fed_llm_160M
#!SBATCH --job-name=fed_llm_1B
