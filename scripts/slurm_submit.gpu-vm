#!SBATCH --job-name=test-distro
#!SBATCH --job-name=mclr-eval-gauntlet
#SBATCH --tasks-per-node=1
#SBATCH --output=%x-%j.out
#SBATCH --partition=debug
#!SBATCH --time=01:00:00
#SBATCH --dependency=afterany:12482

# Default project path
PROJECT_PATH="$HOME/projects/flower_llm"


# Parse command-line options
if ! OPTIONS=$(getopt -o p: --long project_path: -n 'parse-options' -- "$@"); then
  echo "slurm_submit.gpu-vm: Error parsing options" >&2
  exit 1
fi

eval set -- "$OPTIONS"

while true; do
  case "$1" in
    -p | --project_path )
      PROJECT_PATH="$2"; shift 2 ;;
    -- )
      shift; break ;;
    * )
      break ;;
  esac
done
eval "$(cat /home/ls985/.bashrc | tail -n +10)"
echo "slurm_submit.gpu-vm: PROJECT_PATH=$PROJECT_PATH, LD_LIBRARY_PATH=$LD_LIBRARY_PATH, PATH=$PATH"

